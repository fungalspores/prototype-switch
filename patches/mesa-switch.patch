+static void
+vk_switch_preload_gfx(const struct vk_graphics_pipeline *gfx)
+{
+   const struct vk_vertex_input_state *vi = &gfx->linked._dynamic_vi;
+   vk_switch_preload_bytes(&gfx->linked.dynamic, sizeof(gfx->linked.dynamic));
+   vk_switch_preload_bytes(vi, 64);
+   vk_switch_preload_bytes(&vi->attributes_valid,
+                             (const char *)&vi->attributes[8] -
+                             (const char *)&vi->attributes_valid);
+   vk_switch_preload_bytes(&gfx->stage_count,
+                             (const char *)&gfx->stages[2] -
+                             (const char *)&gfx->stage_count);
+}
