+
+constexpr int kW = 1280, kH = 720;
+
+void DrawText(uint32_t* fb, uint32_t stride, const char* text, int scale, int y, uint32_t color) {
+  const int len = int(std::strlen(text));
+  int x = (kW - len * 8 * scale) / 2;
+  for (int i = 0; i < len; ++i, x += 8 * scale) {
+    const unsigned char c = (unsigned char)text[i];
+    if (c < 0x20 || c > 0x7E) continue;
+    const uint8_t* g = kFont[c - 0x20];
+    for (int row = 0; row < 8; ++row)
+      for (int col = 0; col < 8; ++col)
+        if (g[row] & (1u << col))
+          for (int dy = 0; dy < scale; ++dy) {
+            const int py = y + row * scale + dy;
+            if (py < 0 || py >= kH) continue;
+            uint32_t* line = fb + size_t(py) * stride;
+            for (int dx = 0; dx < scale; ++dx) {
+              const int px = x + col * scale + dx;
+              if (px >= 0 && px < kW) line[px] = color;
+            }
+          }
+  }
+}
