@@ -0,0 +1,43 @@
+// EDRAM reuse census (Mercenaries 2 Switch port diagnostic, PLAN_NATIVE_RENDERER.md stage 0).
+//
+// Answers one question: does the game read EDRAM contents through a different render target
+// configuration (base, pitch, MSAA, depth/colour, format) than the one that wrote them? A native
+// renderer that keeps one host image per configuration (project8-sw) loses such contents.
+//
+// Off unless sdmc:/switch/Mercenaries2/logs/rex/edram_census.flag exists at startup (checked once).
+// Every 10 s logs EDRAM_CENSUS summary lines. Only plain functions and file-local state: no SDK
+// class layout changes.
+#pragma once
+
+#include <cstdint>
+#include <utility>
+
+#include <rex/graphics/registers.h>
+#include <rex/graphics/xenos.h>
+
+namespace rex::graphics {
+class RegisterFile;
+class Shader;
+namespace draw_util {
+struct ResolveInfo;
+}
+}  // namespace rex::graphics
+
+namespace rex::graphics::edram_census {
+
+bool Enabled();
+
+// From RenderTargetCache::Update, before ownership changes: the render targets this draw binds.
+// bases_sorted: (EDRAM base in tiles, bit index: 0 depth, 1 + i colour i); lengths_tiles parallel.
+void OnDraw(const RegisterFile& regs, reg::RB_DEPTHCONTROL normalized_depth_control,
+            uint32_t normalized_color_mask, xenos::MsaaSamples msaa_samples,
+            uint32_t pitch_tiles_at_32bpp, const std::pair<uint32_t, uint32_t>* bases_sorted,
+            uint32_t count, const uint32_t* lengths_tiles);
+
+// From the resolve path, after GetResolveInfo succeeded with a non-empty region.
+void OnResolve(const draw_util::ResolveInfo& resolve_info);
+
+// From IssueDraw: whether the draw's shaders export to memory.
+void OnShaders(bool memexport_vertex, bool memexport_pixel);
+
+}  // namespace rex::graphics::edram_census
