diff --git a/sdk/include/rex/ui/gpu_wait_diagnostics.h b/sdk/include/rex/ui/gpu_wait_diagnostics.h
new file mode 100644
index 0000000..1afb1fb
--- /dev/null
+++ b/sdk/include/rex/ui/gpu_wait_diagnostics.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+#if defined(__GNUC__)
+#define P2_GPU_WEAK __attribute__((weak))
+#else
+#define P2_GPU_WEAK
+#endif
+extern "C" {
+uint64_t P2GpuWaitBegin(uint32_t category) P2_GPU_WEAK;
+void P2GpuWaitEnd(uint32_t category,uint64_t start) P2_GPU_WEAK;
+uint32_t P2GpuWaitRole(uint32_t role) P2_GPU_WEAK;
+void P2GpuWaitFrame() P2_GPU_WEAK;
+void P2GpuWaitReport() P2_GPU_WEAK;
+bool P2GpuWaitEnabled() P2_GPU_WEAK;
+void P2GpuWaitFenceSite(int64_t delta,uint64_t start) P2_GPU_WEAK;
+}
+namespace p2::gpuwait {
+enum Category:uint32_t {RingSwap,NativeSwap,Resolve,Submit,SlotWait,ShutdownWait,ReadbackWait,ClearFence,Pacing,WaitMem,WaitMemBlocked,WaitMemOcclusion,GetDataCall,GetDataPendingLatency,Refresh,RefreshCallback,MailboxWait,Paint,PaintOld,RefreshResize,SealRefresh,TrackerAwait,FenceBlock,FencePoll,Acquire,QueueLock,QueueSubmit,QueuePresent,WSIPresent,BQQueueBuffer,RecorderDrain,TextureUploads,Count};
+enum Role:uint32_t {Other,Ring,Guest,Presenter};
+template<class F> decltype(auto) Measure(uint32_t category,F&& fn);
+class Scope {
+ public:explicit Scope(uint32_t c):category_(c),start_(P2GpuWaitBegin?P2GpuWaitBegin(c):0){}
+ ~Scope(){if(start_)P2GpuWaitEnd(category_,start_);}
+ Scope(const Scope&)=delete;Scope& operator=(const Scope&)=delete;
+ uint64_t start()const{return start_;}
+ private:uint32_t category_;uint64_t start_;
+};
+template<class F> decltype(auto) Measure(uint32_t c,F&& fn){Scope scope(c);return fn();}
+class RoleScope {
+ public:explicit RoleScope(uint32_t r):old_(P2GpuWaitRole?P2GpuWaitRole(r):0){}
+ ~RoleScope(){if(P2GpuWaitRole)P2GpuWaitRole(old_);}
+ private:uint32_t old_;
+};
+}
diff --git a/sdk/include/rex/ui/ordered_present.h b/sdk/include/rex/ui/ordered_present.h
new file mode 100644
index 0000000..38dce8b
--- /dev/null
+++ b/sdk/include/rex/ui/ordered_present.h
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+namespace rex::ui {
+// One producer and one worker. A request stays owned until PaintAndPresent
+// returns (after mailbox acquisition and GPU submission), not merely until the
+// worker wakes up. The producer must WaitIdle BEFORE writing/publishing output.
+class OrderedPresentGate {
+ public:
+  struct Stats { uint64_t published=0, completed=0, waits=0, wait_ns=0, max_wait_ns=0; };
+  void Reset() { std::lock_guard<std::mutex> l(mutex_); stopped_=false; pending_=false; stats_={}; }
+  bool WaitIdle() {
+    std::unique_lock<std::mutex> l(mutex_);
+    if (pending_ && !stopped_) {
+      const auto start=std::chrono::steady_clock::now();
+      idle_.wait(l,[this]{return !pending_ || stopped_;});
+      const auto ns=uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+          std::chrono::steady_clock::now()-start).count());
+      ++stats_.waits; stats_.wait_ns+=ns;
+      if(ns>stats_.max_wait_ns)stats_.max_wait_ns=ns;
+    }
+    return !stopped_;
+  }
+  bool Publish() {
+    std::lock_guard<std::mutex> l(mutex_);
+    if(stopped_ || pending_)return false;
+    pending_=true; ++stats_.published; work_.notify_one(); return true;
+  }
+  bool WaitWork() {
+    std::unique_lock<std::mutex> l(mutex_);
+    work_.wait(l,[this]{return pending_ || stopped_;});
+    return !stopped_;
+  }
+  void Complete() {
+    std::lock_guard<std::mutex> l(mutex_);
+    if(pending_){pending_=false;++stats_.completed;}
+    idle_.notify_all();
+  }
+  void Stop() {
+    std::lock_guard<std::mutex> l(mutex_);
+    stopped_=true; work_.notify_all(); idle_.notify_all();
+  }
+  Stats GetStats() {std::lock_guard<std::mutex> l(mutex_);return stats_;}
+ private:
+  std::mutex mutex_;
+  std::condition_variable work_,idle_;
+  bool pending_=false,stopped_=false;
+  Stats stats_;
+};
+} // namespace rex::ui
