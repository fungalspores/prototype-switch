+
+extern "C" void RexSwitchShowSplash(void) {
+  if (!RexSwitchSplashLines) return;
+  const char* const* lines = RexSwitchSplashLines();
+  if (!lines || !lines[0]) return;
+  const unsigned total_ms = RexSwitchSplashMs ? RexSwitchSplashMs() : 2500;
+
+  NWindow* win = nwindowGetDefault();
+  Framebuffer fb;
+  if (R_FAILED(framebufferCreate(&fb, win, kW, kH, PIXEL_FORMAT_RGBA_8888, 2))) return;
+  framebufferMakeLinear(&fb);
+
+  padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+  PadState pad;
+  padInitializeDefault(&pad);
+
+  // Line 0 big (the credit), the rest smaller; fade in and out over the duration.
+  const u64 start = armGetSystemTick();
+  const u64 freq = armGetSystemTickFreq();
+  for (;;) {
+    const u64 ms = (armGetSystemTick() - start) * 1000 / freq;
+    if (ms >= total_ms) break;
+    padUpdate(&pad);
+    if (ms > 300 && (padGetButtonsDown(&pad) & (HidNpadButton_A | HidNpadButton_B | HidNpadButton_Plus))) break;
+    const unsigned fade_in = 400, fade_out = 400;
+    unsigned a = 255;
+    if (ms < fade_in) a = unsigned(ms * 255 / fade_in);
+    else if (ms > total_ms - fade_out) a = unsigned((total_ms - ms) * 255 / fade_out);
+
+    u32 stride = 0;
+    uint32_t* p = static_cast<uint32_t*>(framebufferBegin(&fb, &stride));
+    stride /= sizeof(uint32_t);
+    for (int y = 0; y < kH; ++y) std::memset(p + size_t(y) * stride, 0, kW * 4);
+    const uint32_t white = 0xFF000000u | (a << 16) | (a << 8) | a;
+    const uint32_t grey = 0xFF000000u | ((a * 150 / 255) << 16) | ((a * 150 / 255) << 8) | (a * 150 / 255);
+    int n = 0;
+    while (lines[n]) ++n;
+    int y = kH / 2 - 40 - (n - 1) * 22;
+    // Each line gets the largest scale that fits the screen width (40 px margin on each side).
+    auto fit = [](const char* s, int max_scale) {
+      const int len = int(std::strlen(s));
+      int sc = len ? (kW - 80) / (len * 8) : max_scale;
+      if (sc > max_scale) sc = max_scale;
+      return sc < 1 ? 1 : sc;
+    };
+    const int s0 = fit(lines[0], 6);
+    DrawText(p, stride, lines[0], s0, y, white);
+    y += 8 * s0 + 36;
+    int si = 3;  // one size for every caption line: the one the longest line fits at
+    for (int i = 1; i < n; ++i) si = fit(lines[i], si);
+    for (int i = 1; i < n; ++i) {
+      DrawText(p, stride, lines[i], si, y, grey);
+      y += 8 * si + 14;
+    }
+    framebufferEnd(&fb);
+  }
+  framebufferClose(&fb);
+}
