+
+// Key of one render target configuration, as a native renderer with one image per
+// configuration would see it. Bit 31 marks a valid key.
+constexpr uint32_t kValid = 1u << 31;
+uint32_t MakeKey(uint32_t base, uint32_t pitch32, xenos::MsaaSamples msaa, bool is_depth,
+                 uint32_t format) {
+  return kValid | (base & 0x7FF) | ((pitch32 & 0x3FF) << 11) | ((uint32_t(msaa) & 3) << 21) |
+         (uint32_t(is_depth) << 23) | ((format & 0xF) << 24);
+}
+uint32_t KeyBase(uint32_t k) { return k & 0x7FF; }
+uint32_t KeyPitch(uint32_t k) { return (k >> 11) & 0x3FF; }
+uint32_t KeyMsaa(uint32_t k) { return (k >> 21) & 3; }
+bool KeyDepth(uint32_t k) { return (k >> 23) & 1; }
+uint32_t KeyFormat(uint32_t k) { return (k >> 24) & 0xF; }
+
+// Why two keys differ, as bits.
+enum : uint32_t {
+  kDiffDepthColor = 1,
+  kDiffFormatStorage = 2,  // different storage (real reinterpretation)
+  kDiffFormatSameStorage = 4,  // e.g. 8_8_8_8 vs 8_8_8_8_GAMMA
+  kDiffPitch = 8,
+  kDiffMsaa = 16,
+  kDiffBase = 32,
+};
+uint32_t Diff(uint32_t a, uint32_t b) {
+  uint32_t d = 0;
+  if (KeyDepth(a) != KeyDepth(b)) {
+    d |= kDiffDepthColor;
+  } else if (KeyFormat(a) != KeyFormat(b)) {
+    bool same_storage = false;
+    if (!KeyDepth(a)) {
+      same_storage = xenos::GetStorageColorFormat(xenos::ColorRenderTargetFormat(KeyFormat(a))) ==
+                     xenos::GetStorageColorFormat(xenos::ColorRenderTargetFormat(KeyFormat(b)));
+    }
+    d |= same_storage ? kDiffFormatSameStorage : kDiffFormatStorage;
+  }
+  if (KeyPitch(a) != KeyPitch(b)) d |= kDiffPitch;
+  if (KeyMsaa(a) != KeyMsaa(b)) d |= kDiffMsaa;
+  if (KeyBase(a) != KeyBase(b)) d |= kDiffBase;
+  return d;
+}
