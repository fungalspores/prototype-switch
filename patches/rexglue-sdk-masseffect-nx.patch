+#if REX_PLATFORM_SWITCH
+    if (FILE* f = std::fopen("sdmc:/switch/Mercenaries2/logs/rex/edram_census.flag", "rb")) {
+      std::fclose(f);
+      s.enabled = true;
+    }
+#else
+    s.enabled = std::getenv("REX_EDRAM_CENSUS") != nullptr;
+#endif
+    s.window_start = std::chrono::steady_clock::now();
+    if (s.enabled) REXGPU_INFO("EDRAM_CENSUS enabled=1 window=10s");
+    return s;
+  }();
+  return state;
+}
+
+std::string KeyText(uint32_t k) {
+  char text[64];
+  std::snprintf(text, sizeof(text), "%s%u@%u/p%u/%ux", KeyDepth(k) ? "D" : "C", KeyFormat(k),
+                KeyBase(k), KeyPitch(k), 1u << KeyMsaa(k));
+  return text;
+}
+
+void MaybeReport(State& s) {
+  auto now = std::chrono::steady_clock::now();
+  if (now - s.window_start < std::chrono::seconds(10)) return;
+  s.window_start = now;
+  REXGPU_INFO(
+      "EDRAM_CENSUS draws={} bindings={} bindings_reading_old={} cross_draw_reads={} "
+      "cross_draw_tiles={} cross_overwrites={} resolves={} cross_resolve_reads={} "
+      "cross_resolve_tiles={} clears={} memexport_vs={} memexport_ps={}",
+      s.draws, s.bindings, s.reads_old, s.cross_draw_reads, s.cross_draw_tiles,
+      s.cross_overwrites, s.resolves, s.cross_resolve_reads, s.cross_resolve_tiles, s.clears,
+      s.memexport_vs, s.memexport_ps);
+  REXGPU_INFO(
+      "EDRAM_CENSUS_DIFF depth_color={} format_storage={} format_same_storage={} pitch={} "
+      "msaa={} base={}",
+      s.diff_counts[0], s.diff_counts[1], s.diff_counts[2], s.diff_counts[3], s.diff_counts[4],
+      s.diff_counts[5]);
+  std::vector<std::pair<uint64_t, Transition>> top(s.transitions.begin(), s.transitions.end());
+  std::sort(top.begin(), top.end(), [](const auto& a, const auto& b) {
+    uint64_t ra = a.second.draw_reads + a.second.resolve_reads;
+    uint64_t rb = b.second.draw_reads + b.second.resolve_reads;
+    return ra != rb ? ra > rb : a.second.overwrites > b.second.overwrites;
+  });
+  for (size_t i = 0; i < std::min<size_t>(top.size(), 16); ++i) {
+    uint32_t from = uint32_t(top[i].first >> 32), to = uint32_t(top[i].first);
+    REXGPU_INFO("EDRAM_CENSUS_TOP {} -> {} draw_reads={} resolve_reads={} tiles_read={} "
+                "overwrites={} diff=0x{:02X}",
+                KeyText(from), KeyText(to), top[i].second.draw_reads, top[i].second.resolve_reads,
+                top[i].second.tiles_read, top[i].second.overwrites, Diff(from, to));
+  }
+  s.draws = s.bindings = s.reads_old = 0;
+  s.cross_draw_reads = s.cross_draw_tiles = s.cross_overwrites = 0;
+  s.resolves = s.cross_resolve_reads = s.cross_resolve_tiles = s.clears = 0;
+  s.memexport_vs = s.memexport_ps = 0;
+  std::fill(std::begin(s.diff_counts), std::end(s.diff_counts), 0);
+  s.transitions.clear();
+}
+
+void CountDiff(State& s, uint32_t diff) {
+  for (uint32_t i = 0; i < 6; ++i) {
+    if (diff & (1u << i)) ++s.diff_counts[i];
+  }
+}
+
+// Reads tiles [start, start + length) (wrapping) under key. Returns the number of tiles last
+// written under a different valid key, counting each distinct old key once in transitions.
+uint32_t ReadRange(State& s, uint32_t key, uint32_t start, uint32_t length, bool from_resolve) {
+  uint32_t mismatched = 0;
+  uint32_t last_counted_old = 0;
+  for (uint32_t i = 0; i < length && i < xenos::kEdramTileCount; ++i) {
+    uint32_t old = s.owner[(start + i) % xenos::kEdramTileCount];
+    if (!old || old == key) continue;
+    ++mismatched;
+    Transition& t = s.transitions[(uint64_t(old) << 32) | key];
+    ++t.tiles_read;
+    if (old != last_counted_old) {
+      last_counted_old = old;
+      ++(from_resolve ? t.resolve_reads : t.draw_reads);
+      CountDiff(s, Diff(old, key));
+    }
+  }
+  return mismatched;
+}
+
+// Writes tiles under key; counts owner changes that did not read the old contents.
+void WriteRange(State& s, uint32_t key, uint32_t start, uint32_t length, bool read_before) {
+  bool counted = false;
+  uint32_t last_old = 0;
+  for (uint32_t i = 0; i < length && i < xenos::kEdramTileCount; ++i) {
+    uint32_t& owner = s.owner[(start + i) % xenos::kEdramTileCount];
+    if (owner && owner != key && !read_before) {
+      if (owner != last_old) {
+        last_old = owner;
+        ++s.transitions[(uint64_t(owner) << 32) | key].overwrites;
+      }
+      if (!counted) {
+        counted = true;
+        ++s.cross_overwrites;
+      }
+    }
+    owner = key;
+  }
+}
+
+bool BlendReadsDest(reg::RB_BLENDCONTROL b) {
+  auto reads_dest_factor = [](xenos::BlendFactor f) {
+    return f == xenos::BlendFactor::kDstColor || f == xenos::BlendFactor::kOneMinusDstColor ||
+           f == xenos::BlendFactor::kDstAlpha || f == xenos::BlendFactor::kOneMinusDstAlpha ||
+           f == xenos::BlendFactor::kSrcAlphaSaturate;
+  };
+  if (b.color_comb_fcn == xenos::BlendOp::kMin || b.color_comb_fcn == xenos::BlendOp::kMax ||
+      b.alpha_comb_fcn == xenos::BlendOp::kMin || b.alpha_comb_fcn == xenos::BlendOp::kMax) {
+    return true;
+  }
+  return b.color_destblend != xenos::BlendFactor::kZero ||
+         b.alpha_destblend != xenos::BlendFactor::kZero || reads_dest_factor(b.color_srcblend) ||
+         reads_dest_factor(b.alpha_srcblend);
+}
+
+}  // namespace
+
+bool Enabled() { return GetState().enabled; }
+
+void OnDraw(const RegisterFile& regs, reg::RB_DEPTHCONTROL normalized_depth_control,
+            uint32_t normalized_color_mask, xenos::MsaaSamples msaa_samples,
+            uint32_t pitch_tiles_at_32bpp, const std::pair<uint32_t, uint32_t>* bases_sorted,
+            uint32_t count, const uint32_t* lengths_tiles) {
+  State& s = GetState();
+  if (!s.enabled) return;
+  ++s.draws;
+  auto color_control = regs.Get<reg::RB_COLORCONTROL>();
+  bool alpha_test = color_control.alpha_test_enable &&
+                    color_control.alpha_func != xenos::CompareFunction::kAlways;
+  for (uint32_t i = 0; i < count; ++i) {
+    uint32_t base = bases_sorted[i].first;
+    uint32_t bit = bases_sorted[i].second;
+    uint32_t key;
+    bool reads_old;
+    if (bit == 0) {
+      auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+      key = MakeKey(base, pitch_tiles_at_32bpp, msaa_samples, true,
+                    uint32_t(depth_info.depth_format));
+      bool z_reads = normalized_depth_control.z_enable &&
+                     normalized_depth_control.zfunc != xenos::CompareFunction::kAlways;
+      reads_old = z_reads || normalized_depth_control.stencil_enable ||
+                  (normalized_depth_control.z_enable && !normalized_depth_control.z_write_enable);
+    } else {
+      uint32_t rt = bit - 1;
+      auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[rt]);
+      key = MakeKey(base, pitch_tiles_at_32bpp, msaa_samples, false,
+                    uint32_t(color_info.color_format));
+      uint32_t components =
+          xenos::GetColorRenderTargetFormatComponentCount(color_info.color_format);
+      uint32_t full_mask = (1u << components) - 1;
+      uint32_t mask = (normalized_color_mask >> (4 * rt)) & 0xF;
+      auto blend =
+          regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[rt]);
+      reads_old = (mask & full_mask) != full_mask || BlendReadsDest(blend) || alpha_test;
+    }
+    ++s.bindings;
+    if (reads_old) {
+      ++s.reads_old;
+      uint32_t mismatched = ReadRange(s, key, base, lengths_tiles[i], false);
+      if (mismatched) {
+        ++s.cross_draw_reads;
+        s.cross_draw_tiles += mismatched;
+      }
+    }
+    WriteRange(s, key, base, lengths_tiles[i], reads_old);
+  }
+  MaybeReport(s);
+}
+
+void OnResolve(const draw_util::ResolveInfo& info) {
+  State& s = GetState();
+  if (!s.enabled) return;
+  ++s.resolves;
+  // Copy source: rows of the resolved rectangle.
+  if (info.copy_dest_extent_length) {
+    bool depth = info.IsCopyingDepth();
+    const draw_util::ResolveEdramInfo& e = depth ? info.depth_edram_info : info.color_edram_info;
+    uint32_t key = MakeKey(depth ? info.depth_original_base : info.color_original_base,
+                           e.pitch_tiles >> e.format_is_64bpp, e.msaa_samples, depth, e.format);
+    uint32_t base, row_length, rows, pitch;
+    info.GetCopyEdramTileSpan(base, row_length, rows, pitch);
+    uint32_t mismatched = 0;
+    for (uint32_t r = 0; r < rows; ++r) {
+      mismatched += ReadRange(s, key, base + r * pitch, row_length, true);
+    }
+    if (mismatched) {
+      ++s.cross_resolve_reads;
+      s.cross_resolve_tiles += mismatched;
+    }
+  }
+  // Clears write the cleared rectangle under the cleared configuration.
+  auto clear = [&](const draw_util::ResolveEdramInfo& e, uint32_t original_base, bool depth) {
+    uint32_t key = MakeKey(original_base, e.pitch_tiles >> e.format_is_64bpp, e.msaa_samples,
+                           depth, e.format);
+    uint32_t base, row_length, rows;
+    draw_util::GetResolveEdramTileSpan(e, info.coordinate_info, info.height_div_8, base,
+                                       row_length, rows);
+    for (uint32_t r = 0; r < rows; ++r) {
+      WriteRange(s, key, base + r * e.pitch_tiles, row_length, true);
+    }
+    ++s.clears;
+  };
+  if (info.rb_copy_control.depth_clear_enable) clear(info.depth_edram_info, info.depth_original_base, true);
+  if (info.rb_copy_control.color_clear_enable) clear(info.color_edram_info, info.color_original_base, false);
+  MaybeReport(s);
+}
+
+void OnShaders(bool memexport_vertex, bool memexport_pixel) {
+  State& s = GetState();
+  if (!s.enabled) return;
+  s.memexport_vs += memexport_vertex;
+  s.memexport_ps += memexport_pixel;
+}
+
+}  // namespace rex::graphics::edram_census
